   "source": [
    "# ==========================================\n",
    "# 1. Environment & Workspace Prerequisites\n",
    "# ==========================================\n",
    "import importlib.util\n",
    "import sys\n",
    "import re\n",
    "import os\n",
    "import json\n",
    "import chromadb\n",
    "from typing import List, Dict, Any\n",
    "from pydantic import BaseModel, Field\n",
    "from dotenv import load_dotenv\n",
    "from tavily import TavilyClient\n",
    "\n",
    "# Check if 'pysqlite3' is available before importing\n",
    "if importlib.util.find_spec(\"pysqlite3\") is not None:\n",
    "    import pysqlite3\n",
    "    sys.modules['sqlite3'] = sys.modules.pop('pysqlite3')\n",
    "\n",
    "# Import workspace custom framework modules\n",
    "from lib.agents import Agent\n",
    "from lib.llm import LLM\n",
    "from lib.messages import UserMessage, SystemMessage, ToolMessage, AIMessage\n",
    "from lib.tooling import tool\n",
    "\n",
    "# Force inject fresh workspace API tokens into environment\n",
    "os.environ[\"OPENAI_API_KEY\"] = \"voc-137946404216886553444576a9636d20fb473.23234153\"\n",
    "os.environ[\"TAVILY_API_KEY\"] = \"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\"\n",
    "\n",
    "print(\"✅ Success: New system environment variables injected successfully!\")\n",
    "\n",
    "# Set up local persistent database client connection\n",
    "chroma_client = chromadb.PersistentClient(path=\"chromadb\")\n",
    "collection = chroma_client.get_collection(\"udaplay\")\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 2. Pydantic Response & Validation Schemas\n",
    "# ==========================================\n",
    "class EvaluationReport(BaseModel):\n",
    "    useful: bool = Field(description=\"Whether the documents are useful to completely answer the user question.\")\n",
    "    description: str = Field(description=\"Detailed explanation justifying the evaluation decision.\")\n",
    "\n",
    "class FinalAgentResponse(BaseModel):\n",
    "    natural_language_summary: str = Field(description=\"The conversational, user-friendly response to the query.\")\n",
    "    structured_data: dict = Field(description=\"A dictionary containing supporting raw metrics, links, or facts.\")\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 3. Agent Tool Definitions\n",
    "# ==========================================\n",
    "@tool\n",
    "def query_vector_db(query_text: str, n_results: int = 3) -> str:\n",
    "    \"\"\"Queries the local ChromaDB vector store for relevant Udaplay project documentation.\"\"\"\n",
    "    try:\n",
    "        results = collection.query(\n",
    "            query_texts=[query_text],\n",
    "            n_results=n_results\n",
    "        )\n",
    "        documents = results.get(\"documents\", [[]])\n",
    "        if not documents or len(documents) == 0:\n",
    "            return \"No matching documents found in local database.\"\n",
    "        return \"\\n\\n\".join([f\"[Doc {i+1}]: {doc}\" for i, doc in enumerate(documents)])\n",
    "    except Exception as e:\n",
    "        return f\"Error querying vector database: {str(e)}\"\n",
    "\n",
    "@tool\n",
    "def web_search(query: str) -> str:\n",
    "    \"\"\"Performs a live web search using Tavily to find up-to-date external information.\"\"\"\n",
    "    try:\n",
    "        tavily = TavilyClient(api_key=os.environ[\"TAVILY_API_KEY\"])\n",
    "        response = tavily.search(query=query, max_results=3)\n",
    "        results = response.get(\"results\", [])\n",
    "        if not results:\n",
    "            return \"No relevant web search results found.\"\n",
    "        return \"\\n\\n\".join([f\"[Web Match]: {r['title']}\\nURL: {r['url']}\\nContent: {r['content']}\" for r in results])\n",
    "    except Exception as e:\n",
    "        return f\"Error executing web search: {str(e)}\"\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 4. Agent Class Implementation\n",
    "# ==========================================\n",
    "class UdaplayAgent(Agent):\n",
    "    def __init__(self, model_name: str = \"gpt-4o-mini\"):\n",
    "        \"\"\"\n",
    "        Initializes the agent by passing model_name and instructions \n",
    "        directly to the mandatory parent Agent constructor.\n",
    "        \"\"\"\n",
    "        # CRITICAL UPDATE: Enforce structured JSON schema response output guidelines\n",
    "        instructions = (\n",
    "            \"You are the Udaplay Project Assistant.\\n\"\n",
    "            \"Step 1: Always check local documentation first using query_vector_db.\\n\"\n",
    "            \"Step 2: If documentation is missing critical pieces, run web_search.\\n\"\n",
    "            \"Step 3: You MUST output your final answer as a raw JSON object strictly conforming \"\n",
    "            \"to the FinalAgentResponse schema. Do not output normal markdown text outside of the JSON block.\\n\\n\"\n",
    "            \"Expected Output JSON Format:\\n\"\n",
    "            \"{\\n\"\n",
    "            '  \"natural_language_summary\": \"Conversational text answering user query...\",\\n'\n",
    "            '  \"structured_data\": {\"key_mechanics\": [...], \"sources\": [...]}\\n'\n",
    "            \"}\"\n",
    "        )\n",
    "        \n",
    "        # Pass required positional arguments to Agent.__init__()\n",
    "        super().__init__(model_name, instructions)\n",
    "        \n",
    "        # Register the tools list onto the instantiated object\n",
    "        self.tools = [query_vector_db, web_search]\n",
    "\n",
    "\n",
    "# ==========================================\n",
    "# 5. Agent Execution Loop & Structured Output Verification\n",
    "# ==========================================\n",
    "if __name__ == \"__main__\":\n",
    "    print(\"🤖 Initializing UdaplayAgent...\")\n",
    "    udaplay_agent = UdaplayAgent(model_name=\"gpt-4o-mini\")\n",
    "    user_q = \"What are the core mechanics of Udaplay and are there any recent updates?\"\n",
    "    \n",
    "    print(f\"\\n🚀 Invoking Agent with Query: '{user_q}'\")\n",
    "    run_object = udaplay_agent.invoke(user_q)\n",
    "    \n",
    "    print(\"\\n=======================================================\")\n",
    "    print(\"🎉 State Machine Terminated Successfully!\")\n",
    "    print(\"=======================================================\")\n",
    "    \n",
    "    # Extract messages safely using final state hooks\n",
    "    final_state = run_object.get_final_state()\n",
    "    final_messages = []\n",
    "    if isinstance(final_state, dict):\n",
    "        final_messages = final_state.get(\"messages\", [])\n",
    "    elif hasattr(final_state, \"messages\"):\n",
    "        final_messages = final_state.messages\n",
    "\n",
    "    if final_messages:\n",
    "        raw_content = getattr(final_messages[-1], 'content', str(final_messages[-1])).strip()\n",
    "        \n",
    "        # Strip markdown JSON fences if the LLM wraps them implicitly\n",
    "        if raw_content.startswith(\"```json\"):\n",
    "            raw_content = raw_content.split(\"```json\")[1].split(\"```\")[0].strip()\n",
    "        elif raw_content.startswith(\"```\"):\n",
    "            raw_content = raw_content.split(\"```\")[1].split(\"```\")[0].strip()\n",
    "            \n",
    "        print(\"\\n🔍 Validating Submission Schema Alignment...\")\n",
    "        try:\n",
    "            parsed_json = json.loads(raw_content)\n",
    "            # Instantiating the pydantic schema enforces absolute validation compliance\n",
    "            validated_response = FinalAgentResponse(**parsed_json)\n",
    "            print(\"🌟 SUCCESS: Object is 100% compliant with FinalAgentResponse requirements!\\n\")\n",
    "            \n",
    "            print(\"[1. Natural Language Summary]:\")\n",
    "            print(validated_response.natural_language_summary)\n",
    "            print(\"\\n[2. Structured Data Dictionary]:\")\n",
    "            print(json.dumps(validated_response.structured_data, indent=2))\n",
    "            \n",
    "        except Exception as json_err:\n",
    "            print(\"⚠️ Response returned text format instead of strict JSON schema structure.\")\n",
    "            print(f\"Parsing Context: {str(json_err)}\")\n",
    "            print(f\"\\n[Raw Agent Response Text]:\\n{raw_content}\")\n",
    "    else:\n",
    "        print(\"❌ Error: No messages extracted from final run state records.\")\n"
   ]
  },
